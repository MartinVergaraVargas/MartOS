#!/usr/bin/env bash
# martos — respaldo y restauración de la configuración de MartOS
#          (HP OMEN 16, Ubuntu 24.04)
#
# Modelo: los archivos VIVEN Y SE EDITAN EN SU SITIO ORIGINAL (/etc, ~/.bashrc…).
# ~/.config/MartOS es solo:
#   · el RESPALDO (copia) que se versiona con git y se sube a GitHub, y
#   · la GUÍA (INFORME.md) de dónde está cada archivo y qué hace.
#
#   sistema/   ← copia de los archivos personalizados de /  (etc/…, usr/local/bin/…)
#   bash/      ← copia de ~/.bashrc, ~/.profile, ~/.bash_logout y ~/.bashrc.d/
#   usuario/   ← copia de otros archivos de $HOME (misma ruta relativa)
#   gnome/     ← volcados dconf de los ajustes de escritorio
#
# Uso: martos <orden>   (ver `martos ayuda`)

set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SISTEMA="$REPO/sistema"
GNOME="$REPO/gnome"
PLY="$REPO/personalizacion/plymouth"
PLY_UPSTREAM="https://github.com/adi1090x/plymouth-themes"

# Con sudo, el $HOME relevante es el del usuario que llamó a sudo
HOME_USER="${SUDO_USER:-$USER}"
HOME_DIR="$(getent passwd "$HOME_USER" | cut -d: -f6)"

if [ -t 1 ]; then
    R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[1;34m'; N=$'\e[0m'
else
    R=; G=; Y=; B=; N=
fi

info() { printf '%s==>%s %s\n' "$B" "$N" "$*"; }
warn() { printf '%s!!%s  %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%sERROR:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

need_root()    { [ "$(id -u)" -eq 0 ] || die "esta orden necesita root: sudo martos $*"; }
need_nonroot() { [ "$(id -u)" -ne 0 ] || die "ejecútala como tu usuario, sin sudo"; }

# ---------------------------------------------------------------------------
# Pares "copia en el repo|original en el sistema" de todo lo respaldado
# ---------------------------------------------------------------------------
pairs_sistema() {
    local f
    (cd "$SISTEMA" && find . -type f -printf '%P\n' | sort) | while read -r f; do
        printf '%s|/%s\n' "$SISTEMA/$f" "$f"
    done
}

pairs_usuario() {
    local f
    printf '%s|%s\n' \
        "$REPO/bash/bashrc"      "$HOME_DIR/.bashrc" \
        "$REPO/bash/profile"     "$HOME_DIR/.profile" \
        "$REPO/bash/bash_logout" "$HOME_DIR/.bash_logout"
    (cd "$REPO/bash/bashrc.d" && find . -type f -printf '%P\n' | sort) | while read -r f; do
        printf '%s|%s\n' "$REPO/bash/bashrc.d/$f" "$HOME_DIR/.bashrc.d/$f"
    done
    (cd "$REPO/usuario" && find . -type f -printf '%P\n' | sort) | while read -r f; do
        printf '%s|%s\n' "$REPO/usuario/$f" "$HOME_DIR/$f"
    done
}

pairs_todo() { pairs_sistema; pairs_usuario; }

# Archivos de /etc que pertenecen a la DISTRO (no a tu hardware): con --solo-hardware no se
# copian, porque pisarían los valores por defecto de otra distro/versión. Formato:
#   ruta|qué hacer a mano
DE_LA_DISTRO=(
    "/etc/default/grub|añade 'nvidia-drm.modeset=1' a GRUB_CMDLINE_LINUX_DEFAULT (+ GRUB_TIMEOUT=0, GRUB_TIMEOUT_STYLE=hidden si quieres el menú oculto) y: sudo update-grub"
    "/etc/environment|PENDIENTE: decidir los temporales (TMPDIR). Ver PLAN-MINT.md"
    "/etc/systemd/system/tmp.mount|PENDIENTE: /tmp en RAM (tmpfs 4G). Ver PLAN-MINT.md"
    "/etc/sysctl.d/99-zram-tmp.conf|PENDIENTE (va con los temporales/zram): vm.swappiness=100, vm.page-cluster=0"
    "/etc/systemd/logind.conf|copia solo las líneas que cambiaste: martos diff logind"
    "/etc/bluetooth/main.conf|copia solo las líneas que cambiaste: martos diff bluetooth"
    "/etc/smartd.conf|copia solo las líneas que cambiaste: martos diff smartd"
    "/etc/default/smartmontools|copia solo las líneas que cambiaste: martos diff smartmontools"
    "/etc/modules|omen-rgb-keyboard: su install.sh ya lo carga; si no, añade 'omen_rgb_keyboard'"
    "/etc/gdm3/custom.conf|Mint usa LightDM: Menú → Ventana de inicio de sesión → Usuarios → inicio automático"
    "/etc/prime-discrete|Mint: applet de NVIDIA PRIME → 'bajo demanda' (on-demand)"
    "/etc/hp-manager/rgb.json|probablemente huérfano (INFORME §3): no hace falta"
)
es_de_la_distro() {
    local e
    for e in "${DE_LA_DISTRO[@]}"; do [ "${e%%|*}" = "$1" ] && return 0; done
    return 1
}

# Archivos nuevos en ~/.bashrc.d que aún no están en el respaldo
bashrc_d_nuevos() {
    local f
    [ -d "$HOME_DIR/.bashrc.d" ] || return 0
    for f in "$HOME_DIR/.bashrc.d"/*; do
        [ -f "$f" ] && [ ! -e "$REPO/bash/bashrc.d/$(basename "$f")" ] && echo "$f"
    done
    return 0
}

# ---------------------------------------------------------------------------
# estado / diff
# ---------------------------------------------------------------------------
cmd_estado() {
    local copia orig n_ok=0 n_cambio=0 n_falta=0 nuevo
    info "Comparando el sistema con el respaldo de $REPO"
    while IFS='|' read -r copia orig; do
        if [ ! -e "$orig" ]; then
            printf '  %sFALTA EN EL SISTEMA%s     %s\n' "$R" "$N" "$orig"; n_falta=$((n_falta+1))
        elif cmp -s "$copia" "$orig"; then
            n_ok=$((n_ok+1))
        else
            printf '  %sCAMBIADO%s (sin respaldar)  %s\n' "$Y" "$N" "$orig"; n_cambio=$((n_cambio+1))
        fi
    done < <(pairs_todo)
    while read -r nuevo; do
        [ -n "$nuevo" ] || continue
        printf '  %sNUEVO%s (sin respaldar)     %s\n' "$Y" "$N" "$nuevo"; n_cambio=$((n_cambio+1))
    done < <(bashrc_d_nuevos)
    printf '  %s%d al día%s · %d cambiados/nuevos · %d faltan en el sistema\n' \
        "$G" "$n_ok" "$N" "$n_cambio" "$n_falta"
    [ "$n_cambio" -gt 0 ] && echo "  → guardar en el respaldo: martos respaldar"
    [ "$n_falta" -gt 0 ]  && echo "  → reponerlos: sudo martos restaurar-sistema / martos restaurar-usuario"
    if git -C "$REPO" rev-parse >/dev/null 2>&1 && [ -n "$(git -C "$REPO" status --porcelain)" ]; then
        echo "  → hay cambios en el respaldo sin commit: cd $REPO && git add -A && git commit"
    fi
    return 0
}

cmd_diff() {
    local copia orig filter="${1:-}"
    while IFS='|' read -r copia orig; do
        [ -n "$filter" ] && [[ "$orig" != *"$filter"* ]] && continue
        [ -e "$orig" ] || { echo "--- $orig no existe en el sistema"; continue; }
        cmp -s "$copia" "$orig" && continue
        diff -u --label "respaldo: ${copia#"$REPO"/}" --label "sistema: $orig" "$copia" "$orig" || true
    done < <(pairs_todo)
}

# ---------------------------------------------------------------------------
# respaldar: sistema → repo  (uso diario; sin sudo)
# ---------------------------------------------------------------------------
cmd_respaldar() {
    need_nonroot
    local copia orig n=0 nuevo ini path
    while IFS='|' read -r copia orig; do
        [ -r "$orig" ] || continue
        cmp -s "$copia" "$orig" && continue
        cp -p "$orig" "$copia"; echo "  respaldado $orig"; n=$((n+1))
    done < <(pairs_todo)
    while read -r nuevo; do
        [ -n "$nuevo" ] || continue
        cp -p "$nuevo" "$REPO/bash/bashrc.d/"; echo "  respaldado (nuevo) $nuevo"; n=$((n+1))
    done < <(bashrc_d_nuevos)
    for ini in "$GNOME"/dconf-*.ini; do
        path="/org/gnome/$(basename "$ini" .ini | sed 's/^dconf-//; s/\./\//g')/"
        dconf dump "$path" > "$ini.tmp" && mv "$ini.tmp" "$ini"
    done
    info "$n archivos actualizados (+ ajustes de GNOME)."
    if git -C "$REPO" rev-parse >/dev/null 2>&1; then
        git -C "$REPO" status --short
        echo "Para guardar: cd $REPO && git add -A && git commit -m '…' && git push"
    fi
}

# ---------------------------------------------------------------------------
# restaurar-sistema: repo → /  (tras formatear, o para aplicar el respaldo; root)
# ---------------------------------------------------------------------------
cmd_restaurar_sistema() {
    need_root restaurar-sistema
    local solo_hw=0 ts backup copia orig mode changed=() omitidos=() e
    case "${1:-}" in
        --solo-hardware) solo_hw=1 ;;
        "") ;;
        *) die "opción desconocida '$1' (¿--solo-hardware?)" ;;
    esac
    ts="$(date +%Y%m%d-%H%M%S)"
    backup="/var/backups/martos/$ts"

    while IFS='|' read -r copia orig; do
        if [ "$solo_hw" -eq 1 ] && es_de_la_distro "$orig"; then omitidos+=("$orig"); continue; fi
        if [ -e "$orig" ] && cmp -s "$copia" "$orig"; then continue; fi
        [ -e "$orig" ] && install -D -m 600 "$orig" "$backup$orig"
        if [ -x "$copia" ]; then mode=755; else mode=644; fi
        install -D -o root -g root -m "$mode" "$copia" "$orig"
        echo "  restaurado $orig"
        changed+=("$orig")
    done < <(pairs_sistema)

    if [ "${#changed[@]}" -eq 0 ]; then
        info "El sistema ya coincide con el respaldo."
    else
        [ -d "$backup" ] && info "Lo que había antes quedó en $backup"
        post_install "${changed[@]}"
    fi
    enable_services "$solo_hw"

    if [ "${#omitidos[@]}" -gt 0 ]; then
        info "No restaurados (son de la distro; hazlo a mano). El respaldo está en $SISTEMA:"
        for orig in "${omitidos[@]}"; do
            for e in "${DE_LA_DISTRO[@]}"; do
                [ "${e%%|*}" = "$orig" ] && printf '  %s%s%s\n      → %s\n' "$Y" "$orig" "$N" "${e#*|}"
            done
        done
    fi
}

# Acciones posteriores según qué archivos hayan cambiado
post_install() {
    local all=" $* " reboot=0
    has() { [[ "$all" == *"$1"* ]]; }

    if has /etc/systemd/system/; then systemctl daemon-reload; fi
    if has /etc/udev/rules.d/; then udevadm control --reload; fi
    if has /etc/sysctl.d/; then sysctl --system >/dev/null; fi
    if has /etc/modules-load.d/ || has /etc/modprobe.d/ || has /etc/initramfs-tools/ || has "/etc/modules "; then
        info "Regenerando initramfs (configuración de módulos cambiada)…"
        update-initramfs -u
        systemctl restart systemd-modules-load.service \
            || warn "systemd-modules-load sigue fallando: journalctl -b -u systemd-modules-load"
    fi
    if has /etc/default/grub; then update-grub; reboot=1; fi
    if has /etc/omen-fan/ || has /usr/local/bin/omen-fan || has omen-fan.service; then
        systemctl restart omen-fan.service || warn "omen-fan no arrancó: journalctl -u omen-fan"
    fi
    if has /etc/intel-undervolt.conf; then intel-undervolt apply >/dev/null || warn "intel-undervolt apply falló"; fi
    if has /etc/auto-cpufreq.conf; then systemctl restart auto-cpufreq.service || true; fi
    if has /etc/thermald/; then systemctl restart thermald.service || true; fi
    if has /etc/smartd.conf || has /etc/default/smartmontools; then systemctl restart smartmontools.service || true; fi
    if has /etc/nvidia-power-limit.conf || has nvidia-power-limit; then systemctl start nvidia-power-limit.service || true; fi
    if has /etc/bluetooth/; then systemctl restart bluetooth.service || true; fi
    # logind, gdm3, zram, environment, tmp.mount: no se reinician en caliente
    # (cortaría la sesión gráfica); los cambios REALES se aplican al reiniciar.
    if has /etc/systemd/logind.conf || has /etc/gdm3/ || has zram-generator || has /etc/environment || has tmp.mount; then
        reboot=1
    fi
    [ "$reboot" -eq 1 ] && warn "Si algo de lo anterior cambió de verdad (no solo comentarios), se aplica al REINICIAR."
    return 0
}

enable_services() {
    local solo_hw="${1:-0}" u
    # power-profiles-daemon choca con auto-cpufreq
    systemctl is-enabled power-profiles-daemon.service 2>/dev/null | grep -q masked \
        || systemctl mask power-profiles-daemon.service 2>/dev/null || true
    for u in omen-fan.service nvidia-power-limit.service intel-undervolt.service \
             auto-cpufreq.service thermald.service tmp.mount; do
        # tmp.mount (/tmp en RAM) es una decisión pendiente, no hardware
        [ "$solo_hw" -eq 1 ] && [ "$u" = tmp.mount ] && continue
        if systemctl cat "$u" >/dev/null 2>&1; then
            systemctl is-enabled -q "$u" 2>/dev/null || { systemctl enable "$u" && echo "  habilitado $u"; }
        else
            warn "$u no existe (¿falta instalar su programa? ver INFORME.md §4)"
        fi
    done
}

# ---------------------------------------------------------------------------
# restaurar-usuario: repo → $HOME por COPIA (tras formatear)
# ---------------------------------------------------------------------------
cmd_restaurar_usuario() {
    need_nonroot
    local copia orig rel backup
    backup="$HOME_DIR/.local/state/martos/antes-de-restaurar-$(date +%Y%m%d-%H%M%S)"
    while IFS='|' read -r copia orig; do
        [ -f "$orig" ] && [ ! -L "$orig" ] && cmp -s "$copia" "$orig" && continue
        rel="${orig#"$HOME_DIR"}"
        if [ -e "$orig" ] || [ -L "$orig" ]; then
            mkdir -p "$(dirname "$backup$rel")"
            mv "$orig" "$backup$rel"
        fi
        mkdir -p "$(dirname "$orig")"
        cp -p "$copia" "$orig"
        echo "  restaurado $orig"
    done < <(pairs_usuario)
    [ -d "$backup" ] && info "Lo que había antes quedó en $backup"
    info "Listo. Abre una terminal nueva."
}

# ---------------------------------------------------------------------------
# gnome: carga los ajustes dconf y el fondo (tras formatear)
# ---------------------------------------------------------------------------
cmd_gnome() {
    need_nonroot
    local ini path
    for ini in "$GNOME"/dconf-*.ini; do
        # dconf-desktop.wm.keybindings.ini → /org/gnome/desktop/wm/keybindings/
        path="/org/gnome/$(basename "$ini" .ini | sed 's/^dconf-//; s/\./\//g')/"
        dconf load "$path" < "$ini" && echo "  cargado $path"
    done
    if [ ! -e "$HOME_DIR/.config/background" ]; then
        cp "$REPO/personalizacion/fondos/horizon_upscayl_2x_digital-art-4x.png" "$HOME_DIR/.config/background"
        echo "  fondo restaurado en ~/.config/background"
    fi
}

# ---------------------------------------------------------------------------
# plymouth
# ---------------------------------------------------------------------------
find_theme() {
    local d
    for d in "$PLY/temas/$1" "$PLY"/packs/pack_*/"$1"; do
        [ -f "$d/$1.plymouth" ] && { echo "$d"; return 0; }
    done
    return 1
}

cmd_plymouth() {
    local sub="${1:-listar}"; shift || true
    case "$sub" in
        listar)
            info "Tema activo: $(basename "$(readlink -f /usr/share/plymouth/themes/default.plymouth)" .plymouth)"
            info "Temas guardados en el repo (temas/):"; ls "$PLY/temas" | sed 's/^/  /'
            if compgen -G "$PLY/packs/pack_*" >/dev/null; then
                info "Temas en los packs descargados:"
                for p in "$PLY"/packs/pack_*; do printf '  %s: %s\n' "$(basename "$p")" "$(ls "$p" | tr '\n' ' ')"; done
            else
                warn "Packs no descargados. Ejecuta: martos plymouth descargar"
            fi ;;
        descargar)
            need_nonroot
            local tmp; tmp="$(mktemp -d)"
            git clone --depth 1 "$PLY_UPSTREAM" "$tmp/pt"
            mkdir -p "$PLY/packs"
            for p in "$tmp"/pt/pack_*; do rm -rf "$PLY/packs/$(basename "$p")"; mv "$p" "$PLY/packs/"; done
            rm -rf "$tmp"; info "Packs descargados en $PLY/packs" ;;
        instalar)
            need_root plymouth instalar
            local name="${1:?indica el tema: martos plymouth instalar <tema>}" src dst
            src="$(find_theme "$name")" || die "tema '$name' no encontrado (martos plymouth listar)"
            dst="/usr/share/plymouth/themes/$name"
            rm -rf "$dst"; cp -r "$src" "$dst"; chown -R root:root "$dst"
            update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth "$dst/$name.plymouth" 100
            update-alternatives --set default.plymouth "$dst/$name.plymouth"
            info "Regenerando initramfs…"; update-initramfs -u
            info "Tema '$name' activo. Se verá en el próximo arranque." ;;
        probar)
            need_root plymouth probar
            plymouthd; plymouth --show-splash; sleep "${1:-6}"; plymouth quit ;;
        *) die "subórdenes: listar | descargar | instalar <tema> | probar [segundos]" ;;
    esac
}

cmd_ayuda() {
    cat <<EOF
martos — respaldo y guía de la configuración de MartOS ($REPO)

Los archivos se editan EN SU SITIO (/etc/…, ~/.bashrc, ~/.bashrc.d/…).
Dónde está cada uno y qué hace: $REPO/INFORME.md

Uso diario
  martos estado               ¿hay cambios en el sistema sin respaldar?
  martos diff [texto]         qué ha cambiado respecto al respaldo (filtra por ruta)
  martos respaldar            copia los cambios al respaldo (+ ajustes GNOME)
                              luego: git add -A && git commit && git push

Tras formatear
  sudo martos restaurar-sistema   respaldo → /etc, /usr/local/bin (+ servicios)
        --solo-hardware           solo lo de tu hardware (ventiladores, undervolt, NVIDIA…);
                                  lo propio de la distro (grub, logind…) lo lista para hacerlo a mano
  martos restaurar-usuario        respaldo → ~/.bashrc, ~/.bashrc.d…
  martos gnome                    atajos, dock y fondo

Plymouth
  martos plymouth listar | descargar
  sudo martos plymouth instalar <tema> | probar [segundos]
EOF
}

case "${1:-ayuda}" in
    estado)              shift; cmd_estado "$@" ;;
    diff)                shift; cmd_diff "$@" ;;
    respaldar)           shift; cmd_respaldar "$@" ;;
    restaurar-sistema)   shift; cmd_restaurar_sistema "$@" ;;
    restaurar-usuario)   shift; cmd_restaurar_usuario "$@" ;;
    gnome)               shift; cmd_gnome "$@" ;;
    plymouth)            shift; cmd_plymouth "$@" ;;
    ayuda|-h|--help)     cmd_ayuda ;;
    *) die "orden desconocida '$1' (martos ayuda)" ;;
esac
