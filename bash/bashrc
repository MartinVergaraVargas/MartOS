# ~/.config/MartOS/bash/bashrc (enlazado como ~/.bashrc): ejecutado por bash(1) para shells interactivos no-login.
# Ver /usr/share/doc/bash/examples/startup-files para ejemplos.

# Si no es una sesión interactiva, no hacer nada.
case $- in
    *i*) ;;
      *) return;;
esac

# ---------------------------------------------------------------------------
# Conda (se deja aquí, sin modularizar, porque 'conda init' gestiona este
# bloque buscando sus marcadores justamente en ~/.bashrc).
# ---------------------------------------------------------------------------
# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/opt/miniconda3/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/opt/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/opt/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/opt/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# ---------------------------------------------------------------------------
# Cargar los módulos de ~/.config/MartOS/bash/ (NN-nombre.sh) en orden.
# Para añadir configuración nueva, basta con crear ahí un archivo NN-algo.sh.
# (~/.bashrc es un symlink a ~/.config/MartOS/bash/bashrc)
# ---------------------------------------------------------------------------
MARTOS_BASH="${XDG_CONFIG_HOME:-$HOME/.config}/MartOS/bash"
if [ -d "$MARTOS_BASH" ]; then
    for _rc in "$MARTOS_BASH"/[0-9][0-9]-*.sh; do
        [ -r "$_rc" ] && . "$_rc"
    done
    unset _rc
fi
