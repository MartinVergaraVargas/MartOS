# ──────────────────────────────────────────────────────────────────
# MartOS
# Servicio que mantiene vivo omen-fand2 (control de ventiladores por EC).
# Carga ec_sys con escritura, arranca el daemon y, al parar, devuelve los
# ventiladores al BIOS (omen-fan-restore). Watchdog: si se cuelga, se reinicia.
# Tras editar: sudo systemctl daemon-reload && sudo systemctl restart omen-fan
# Guía de todos los archivos: ~/.config/MartOS/INFORME.md
# ──────────────────────────────────────────────────────────────────
[Unit]
Description=OMEN 16 fan curve daemon (AC/battery aware)
Documentation=https://github.com/alou-S/omen-fan
After=multi-user.target
ConditionVirtualization=false

[Service]
Type=notify
NotifyAccess=main
ExecStartPre=/sbin/modprobe ec_sys write_support=1
ExecStart=/usr/local/bin/omen-fand2
ExecStopPost=/usr/local/bin/omen-fan-restore
WatchdogSec=20
Restart=always
RestartSec=2
# Si el proceso muere de golpe, systemd relanza; el daemon reevalua al arrancar.

[Install]
WantedBy=multi-user.target
